<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote name="xephira"
          fetch="https://github.com/XephiraOS"
          revision="lineage-23.2" />

  <!-- Remove upstream LineageOS projects -->
  <remove-project name="LineageOS/android_packages_apps_Settings" />
  <remove-project name="LineageOS/android_vendor_lineage" />

  <!-- XephiraOS Projects -->
  <project path="packages/apps/Settings" name="android_packages_apps_Settings" remote="xephira" />
  <project path="vendor/lineage" name="android_vendor_lineage" remote="xephira" />

</manifest>
