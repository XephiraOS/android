<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote name="xephira"
          fetch="https://github.com/XephiraOS"
          revision="lineage-23.2" />

  <!-- Remove upstream LineageOS projects -->
  <remove-project name="LineageOS/android_frameworks_base" />
  <remove-project name="LineageOS/android_packages_apps_Launcher3" />
  <remove-project name="LineageOS/android_packages_apps_Settings" />
  <remove-project name="LineageOS/android_vendor_lineage" />

  <!-- Remove unused LineageOS stock apps -->
  <remove-project name="LineageOS/android_packages_apps_Aperture" />
  <remove-project name="LineageOS/android_packages_apps_Glimpse" />
  <remove-project name="LineageOS/android_packages_apps_Jelly" />
  <remove-project name="LineageOS/android_packages_apps_Recorder" />
  <remove-project name="LineageOS/android_packages_apps_Seedvault" />
  <remove-project name="LineageOS/android_packages_apps_Twelve" />

  <!-- XephiraOS Core Projects -->
  <project path="frameworks/base" name="android_frameworks_base" remote="xephira" />
  <project path="packages/apps/Launcher3" name="packages_apps_Launcher3" remote="xephira" />
  <project path="packages/apps/Settings" name="android_packages_apps_Settings" remote="xephira" />
  <project path="vendor/lineage" name="android_vendor_lineage" remote="xephira" />

  <!-- XephiraOS GMS & Theme Packages -->
  <project path="vendor/gms" name="vendor_gms" remote="xephira" clone-depth="1" />
  <project path="vendor/google/overlays/ThemeIcons" name="vendor_google_overlays_ThemeIcons" remote="xephira" />

</manifest>

